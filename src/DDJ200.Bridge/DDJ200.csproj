<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\net8.0\</OutputPath>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ddj200</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <Product>DDJ-200 Codex Bridge</Product>
    <Description>Community DDJ-200 bridge for Codex Micro</Description>
    <Company>DDJ-200 Codex Bridge community project</Company>
    <ApplicationIcon>..\..\assets\windows\ddj200-codex-bridge.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="ProductProfile.cs" />
    <Compile Include="ControlIdentifier.cs" />
    <Compile Include="Protocol.cs" />
    <Compile Include="Midi.cs" />
    <Compile Include="BleGattMidi.cs" />
    <Compile Include="MidiLearn.cs" />
    <Compile Include="MicroMidi.cs" />
    <Compile Include="MicroProtocol.cs" />
    <Compile Include="MicroSetup.cs" />
    <Compile Include="MicroSetupTests.cs" />
    <Compile Include="MicroUsbIp.cs" />
    <Compile Include="Surface12.cs" />
    <Compile Include="AnalogSurface.cs" />
    <Compile Include="BoundedEventLog.cs" />
    <Compile Include="DeviceOwnership.cs" />
    <Compile Include="Surface12Tests.cs" />
    <Compile Include="AnalogSurfaceTests.cs" />
    <Compile Include="BoundedEventLogTests.cs" />
    <Compile Include="MicroMidiTests.cs" />
    <Compile Include="MicroTests.cs" />
    <None Include="config\controller-profile.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><Compile Include="..\Shared\ProfileMigration.cs" Link="ProfileMigration.cs" /></ItemGroup>
  <ItemGroup><PackageReference Include="Tomlyn" Version="0.19.0" /></ItemGroup>
</Project>
